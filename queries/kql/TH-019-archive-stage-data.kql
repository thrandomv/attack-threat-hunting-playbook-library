// | where Timestamp > ago(Lookback) and ActionType in ("FileCreated", "FileModified")
// | where FileName endswith ".zip" or FileName endswith ".rar" or FileName endswith ".7z"
//      or FileName endswith ".cab" or FileName endswith ".tar" or FileName endswith ".gz"
//      or FileName matches regex @"\.(z|r)\d{2,3}$"     // split volumes
// | where FolderPath has_any (StagingPaths)
// | extend SizeMb = round(todouble(FileSize) / 1048576, 1)
// | where SizeMb >= MinSizeMb
// | project Timestamp, DeviceName, FolderPath, FileName, SizeMb, SHA256,
//           InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName
// | order by SizeMb desc
