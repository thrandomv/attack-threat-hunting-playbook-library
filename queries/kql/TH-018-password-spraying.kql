// TH-018 | Surface: Microsoft Sentinel / Log Analytics
// Purpose: Detect one source guessing passwords across many Entra accounts, and surface the
//          sign-ins where the password actually worked.
// Required data: SigninLogs. Add AADNonInteractiveUserSignInLogs for legacy-protocol spraying.
// ATT&CK: T1110.003 | Detection strategy DET0487 / AN1339
// Tunable: MinDistinctUsers (FailedUserRatio), Window (TimeWindow),
//          MaxAttemptsPerUser (PasswordReuseThreshold), KnownEgressIps (GeoIPAnomalyCheck)
//
// Result-code classification matters. Treating every non-zero ResultType as a failed password
// over-counts (disabled accounts, Conditional Access blocks) and hides the important outcome:
// 50074 / 50076 / 50079 / 500121 mean the password was accepted and the sign-in stopped at MFA.
let Lookback = 24h;
let Window = 20m;
let MinDistinctUsers = 10;
let MinFailures = 15;
let MaxAttemptsPerUser = 3.0;
let PasswordFailureCodes = dynamic([50126,   // invalid username or password
                                    50053,   // account locked / too many attempts
                                    50055,   // password expired
                                    50056]); // invalid or null password
let CredentialValidCodes = dynamic([0,       // success
                                    50074,   // MFA challenge not satisfied
                                    50076,   // MFA required by Conditional Access
                                    50079,   // MFA enrolment required
                                    500121,  // strong authentication failed
                                    53003]); // blocked by Conditional Access after credential validation
let KnownEgressIps = dynamic(["192.0.2.30"]);  // RFC 5737 placeholder: corporate NAT / VPN egress.
SigninLogs
| where TimeGenerated > ago(Lookback)
| extend Result = toint(ResultType)
| extend Classification = case(
    Result in (PasswordFailureCodes), "password_failure",
    Result in (CredentialValidCodes), "credential_valid",
    "other")
| where Classification != "other"          // ignore disabled accounts, token errors and policy noise
| where IPAddress !in (KnownEgressIps)
| summarize FailureCount        = countif(Classification == "password_failure"),
            DistinctFailedUsers = dcountif(UserPrincipalName, Classification == "password_failure"),
            FailedUsers         = make_set_if(UserPrincipalName, Classification == "password_failure", 100),
            FailureCodes        = make_set_if(Result, Classification == "password_failure", 20),
            CredentialValidCount= countif(Classification == "credential_valid"),
            CredentialValidUsers= make_set_if(UserPrincipalName, Classification == "credential_valid", 50),
            CredentialValidCodesSeen = make_set_if(Result, Classification == "credential_valid", 20),
            FullSuccessCount    = countif(Result == 0),
            Applications        = make_set(AppDisplayName, 20),
            ClientApps          = make_set(ClientAppUsed, 10),
            UserAgents          = make_set(UserAgent, 10),
            Locations           = make_set(strcat(tostring(LocationDetails.countryOrRegion), "/",
                                                  tostring(LocationDetails.city)), 10),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
            by IPAddress, bin(TimeGenerated, Window)
| extend AttemptsPerUser = round(todouble(FailureCount) / max_of(DistinctFailedUsers, 1), 2)
| where DistinctFailedUsers >= MinDistinctUsers and FailureCount >= MinFailures
    and AttemptsPerUser <= MaxAttemptsPerUser
| extend Severity = case(FullSuccessCount > 0,      "critical - password guessed and sign-in completed",
                         CredentialValidCount > 0,  "critical - password accepted, blocked at MFA or CA",
                                                    "high - spray in progress, no confirmed success"),
         LegacyAuthInvolved = ClientApps has_any (dynamic(["IMAP4", "POP3", "SMTP", "Exchange ActiveSync",
                                                           "Other clients", "Authenticated SMTP"]))
| project SprayWindow = TimeGenerated, FirstSeen, LastSeen, Severity, IPAddress, Locations,
          FailureCount, DistinctFailedUsers, AttemptsPerUser, FailureCodes,
          CredentialValidCount, CredentialValidUsers, CredentialValidCodesSeen, FullSuccessCount,
          LegacyAuthInvolved, Applications, ClientApps, UserAgents, FailedUsers
| order by CredentialValidCount desc, DistinctFailedUsers desc
//
// Repeat over AADNonInteractiveUserSignInLogs - legacy-protocol spraying frequently appears only there:
// AADNonInteractiveUserSignInLogs | where TimeGenerated > ago(Lookback) | ... (same logic)
//
// Slow-spray pass (run daily): widen the window, raise the user count, drop the attempts-per-user cap.
// let SlowWindow = 24h; let SlowMinUsers = 40;
