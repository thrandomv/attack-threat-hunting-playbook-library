// | where Timestamp > ago(Lookback)
// | extend Cmd = tolower(ProcessCommandLine)
// | where Cmd contains "responder" or Cmd contains "inveigh" or Cmd contains "ntlmrelayx"
//      or Cmd contains "petitpotam" or Cmd contains "coercer" or Cmd contains "dfscoerce"
//      or Cmd contains "printerbug" or Cmd contains "spoolsample"
// | project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
