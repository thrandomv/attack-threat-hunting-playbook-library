//              TargetUser = tostring(column_ifexists("TargetUserName", "")),
//              AuthPackage = tostring(column_ifexists("AuthenticationPackageName", "")),
//              SourceIp = tostring(column_ifexists("IpAddress", "")),
//              Workstation = tostring(column_ifexists("WorkstationName", ""))
//     | where LogonTypeValue == 3 and AuthPackage has "NTLM" and TargetUser endswith "$"
//     | where TargetUser !startswith Workstation      // the machine account is not authenticating from its own host
//     | where SourceIp !in ("", "-", "127.0.0.1", "::1");
