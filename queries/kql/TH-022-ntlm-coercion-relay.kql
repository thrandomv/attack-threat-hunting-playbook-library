// TH-022 | Surface: Microsoft Sentinel / Log Analytics
// Purpose: Find authentication coercion (named-pipe access) and the machine-account NTLM
//          authentication that a successful relay produces.
// Required data: SecurityEvent 5145 (Audit Detailed File Share) and 4624 from DCs and servers.
// ATT&CK: T1187, T1557.001 | Detection strategies DET0022 / AN0065, DET0462 / AN1274
// Tunable: CoercionPipes (LureExtensions), ApprovedSourceSubnets (UntrustedCIDR), Window (TimeWindow)
let Lookback = 7d;
let Window = 10m;
let CoercionPipes = dynamic(["efsrpc", "efsr", "lsarpc", "netdfs", "spoolss", "samr", "netlogon", "fssagentrpc"]);
// Express approved sources as subnets: per-host allowlists rot. Replace with your DC/management ranges.
let ApprovedSourceSubnets = dynamic(["10.10.0.0/24", "10.10.1.0/24"]);
let PipeAccess = SecurityEvent
    | where TimeGenerated > ago(Lookback) and EventID == 5145
    | extend ShareName   = tolower(tostring(column_ifexists("ShareName", ""))),
             PipeName    = tolower(tostring(column_ifexists("RelativeTargetName", ""))),
             SourceIp    = tostring(column_ifexists("IpAddress", "")),
             Subject     = tostring(column_ifexists("SubjectAccount", Account)),
             AccessList  = tostring(column_ifexists("AccessList", ""))
    | where ShareName contains "ipc$"
    | where PipeName in~ (CoercionPipes)
    | extend SourceIp = iff(SourceIp startswith "::ffff:", substring(SourceIp, 7), SourceIp)
    | where not(ipv4_is_in_any_range(SourceIp, ApprovedSourceSubnets))
    | project TimeGenerated, Computer, PipeName, SourceIp, Subject, AccessList;
// Branch 1: coercion attempts.
PipeAccess
| summarize Attempts = count(), Pipes = make_set(PipeName, 10), Targets = make_set(Computer, 20),
            Accounts = make_set(Subject, 10),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
            by SourceIp, bin(TimeGenerated, Window)
| extend Assessment = strcat("Coercion pipe access from an unapproved source: ", tostring(Pipes))
| project TimeWindow = TimeGenerated, FirstSeen, LastSeen, Assessment, SourceIp, Attempts,
          Pipes, Targets, Accounts
| order by Attempts desc
//
// Branch 2: the relay outcome - a machine account authenticating over NTLM from an address that is
// not its own host. Run separately and correlate on time and source with branch 1.
