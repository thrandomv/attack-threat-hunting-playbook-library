// TH-013 | Surface: Microsoft Sentinel / Log Analytics
// Purpose: Surface account creation/enablement and privileged group additions, matched by SID.
// Required data: SecurityEvent account-management events from DCs and member servers.
// ATT&CK: T1098, T1136.001 | Detection strategies DET0096 / AN0265, DET0447 / AN1235
// Tunable: PrivilegedGroupSids (HighPrivilegeGroupList), ApprovedIdentityActors (SubjectTargetMismatch)
//
// Why SIDs and not names: "Domain Admins" is "Admins du domaine" on a French installation and
// "Administradores de dominio" on a Spanish one. Well-known SIDs are locale-independent and survive
// group renaming. Name matching silently fails in multi-region estates.
let Lookback = 7d;
// Domain Admins (-512), Schema Admins (-518), Enterprise Admins (-519), GPO Creator Owners (-520)
let PrivilegedRidSuffixes = dynamic(["-512", "-518", "-519", "-520"]);
let BuiltinPrivilegedSids = dynamic(["S-1-5-32-544",  // Administrators
                                     "S-1-5-32-548",  // Account Operators
                                     "S-1-5-32-549",  // Server Operators
                                     "S-1-5-32-551",  // Backup Operators
                                     "S-1-5-32-550"]); // Print Operators
let CustomTier0GroupSids = dynamic([]);   // Add your own tier-0 group SIDs, including nested ones.
let ApprovedIdentityActors = dynamic([]); // e.g. "CONTOSO\\svc-iam"
let GroupChangeEvents = dynamic([4728, 4732, 4756]);   // global, local, universal group member added
let AccountEvents = dynamic([4720, 4722, 4724, 4738]); // created, enabled, password reset, changed
SecurityEvent
| where TimeGenerated > ago(Lookback) and EventID in (GroupChangeEvents) or EventID in (AccountEvents)
| extend Actor      = tostring(column_ifexists("SubjectAccount", Account)),
         ActorSid   = tostring(column_ifexists("SubjectUserSid", "")),
         Member     = tostring(column_ifexists("MemberName", "")),
         MemberSid  = tostring(column_ifexists("MemberSid", "")),
         GroupName  = tostring(column_ifexists("TargetUserName", "")),
         GroupSid   = tostring(column_ifexists("TargetSid", column_ifexists("TargetUserSid", ""))),
         TargetAccount = tostring(column_ifexists("TargetAccount", ""))
| extend IsPrivilegedGroup = EventID in (GroupChangeEvents)
                             and (GroupSid in (BuiltinPrivilegedSids)
                                  or GroupSid in (CustomTier0GroupSids)
                                  or GroupSid has_any (PrivilegedRidSuffixes))
| extend ChangeType = case(
    EventID == 4720, "Account created",
    EventID == 4722, "Account enabled",
    EventID == 4724, "Password reset by another principal",
    EventID == 4738, "Account attributes changed",
    EventID in (GroupChangeEvents) and IsPrivilegedGroup, "Privileged group member added",
    "Group member added")
| where IsPrivilegedGroup or EventID in (4720, 4722)
| where Actor !in~ (ApprovedIdentityActors)
| extend SelfElevation = isnotempty(MemberSid) and MemberSid == ActorSid,
         // Replace the naming heuristic below with a watchlist of your domain controllers.
         IsDomainController = Computer has_any (dynamic(["dc0", "dc1", "dc2"]))
| project TimeGenerated, Computer, EventID, ChangeType, Actor, ActorSid, Member, MemberSid,
          GroupName, GroupSid, TargetAccount, IsPrivilegedGroup, SelfElevation, IsDomainController,
          Activity
| order by IsPrivilegedGroup desc, SelfElevation desc, TimeGenerated desc
//
// Companion - who normally changes privileged group membership (run before deployment):
// SecurityEvent
// | where TimeGenerated > ago(90d) and EventID in (4728, 4732, 4756)
// | extend GroupSid = tostring(column_ifexists("TargetSid", ""))
// | where GroupSid has_any (PrivilegedRidSuffixes) or GroupSid in (BuiltinPrivilegedSids)
// | summarize Changes = count(), Groups = make_set(column_ifexists("TargetUserName", ""), 20)
//             by Actor = tostring(column_ifexists("SubjectAccount", ""))
// | order by Changes desc
