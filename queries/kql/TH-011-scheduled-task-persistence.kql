// | extend TaskName = tostring(column_ifexists("TaskName", "")),
//          TaskXml  = tolower(tostring(column_ifexists("TaskContent", column_ifexists("TaskContentNew", ""))))
// | where TaskXml contains "powershell" or TaskXml contains "cmd.exe" or TaskXml contains "mshta"
//      or TaskXml contains "\\appdata\\" or TaskXml contains "\\users\\public\\"
//      or TaskXml contains "http://" or TaskXml contains "https://"
// | project TimeGenerated, Computer, EventID, TaskName, SubjectAccount = column_ifexists("SubjectAccount", ""), TaskXml
